# ============================================================
# 门户资讯：公共新闻 API
# ============================================================
# gdelt（默认，免费无需密钥）| newsapi（备用，需 Key）| dify（可选工作流）
NEWS_PROVIDER=gdelt

# 默认检索词（GDELT / NewsAPI）
NEWS_DEFAULT_QUERY=water pollution OR water quality OR river restoration OR wetland restoration

# GDELT 地址（可选）
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# NewsAPI 备用密钥（可选；免费开发者层级仅限开发测试）
NEWS_API_KEY=
# NewsAPI 地址（可选）
NEWSAPI_BASE_URL=https://newsapi.org/v2

# 公共 RSS 备用源（免费、公开、无需密钥，默认开启）
NEWS_RSS_ENABLED=true
# 可选：JSON 数组自定义 RSS；为空时使用内置 ScienceDaily / Guardian / Phys.org / Circle of Blue
# NEWS_RSS_FEEDS=[{"url":"https://www.sciencedaily.com/rss/earth_climate/water.xml","name":"ScienceDaily · Water"}]
NEWS_RSS_FEEDS=

# ============================================================
# Dify 新闻工作流（可选，NEWS_PROVIDER=dify 时使用）
# ============================================================
DIFY_NEWS_API_KEY=
DIFY_NEWS_BASE_URL=
DIFY_NEWS_QUERY_FIELD=query
DIFY_NEWS_LIMIT_FIELD=
DIFY_NEWS_EXTRA_INPUTS={}

# ============================================================
# Dify 专业诊断工作流（密钥只在服务端）
# ============================================================
DIFY_BASE_URL=https://api.dify.ai
DIFY_API_KEY=

# ============================================================
# 生产服务
# ============================================================
PORT=8787

# 公开演示版：固定本地样例，不调用 Dify。
# 生产构建已由 .env.production 的 VITE_PUBLIC_DEMO_ONLY=true 默认锁定；
# 服务端在 NODE_ENV=production 下也默认拒绝实时调用。
# 私有生产环境如确需开启实时模式，需同时设置：
#   VITE_PUBLIC_DEMO_ONLY=false
#   ALLOW_LIVE_DIFY=true
# 本地开发（npm run dev）不受影响。
